{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CCPilot",
  "version": "0.1.0",
  "identifier": "com.binfenhulian.ccpilot",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CCPilot",
        "width": 760,
        "height": 820,
        "minWidth": 480,
        "minHeight": 400,
        "dragDropEnabled": false
      },
      {
        "label": "global-todos",
        "title": "CCPilot · Global Todos",
        "url": "/",
        "width": 520,
        "height": 720,
        "minWidth": 360,
        "minHeight": 420,
        "visible": false,
        "center": true,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
